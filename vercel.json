{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "client": {
            "root": "client",
            "framework": "create-react-app"
        },
        "server": {
            "root": "server",
            "framework": "express"
        }
    },
    "functions": {
        "api/(.*)": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}